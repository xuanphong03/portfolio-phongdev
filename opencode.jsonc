{
    "$schema": "https://opencode.ai/config.json",
    "providers": {
        "9router": {
            "name": "9Router",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": { "baseURL": "http://127.0.0.1:20128/v1" },
            "models": {
                "gpt-5.6-sol": {
                    "name": "cx/gpt-5.6-sol",
                    "modelID": "cx/gpt-5.6-sol",
                },
                "gemini-3.8-flash-high": {
                    "name": "ag/gemini-3.8-flash-high",
                    "modelID": "ag/gemini-3.8-flash-high",
                },
                "claude-sonnet-4.6-thinking": {
                    "name": "ag/claude-sonnet-4-6",
                    "modelID": "ag/claude-sonnet-4-6",
                },
                "claude-opus-4.6-thinking": {
                    "name": "ag/claude-opus-4-6-thinking",
                    "modelID": "ag/claude-opus-4-6-thinking",
                },
            },
        },
    },
    "mcp": {
        "timeout": { "startup": 60000, "catalog": 60000, "execution": 600000 },
        "servers": {
            "ark-ui": {
                "type": "local",
                "command": ["npx", "-y", "@ark-ui/mcp"],
            },
            "next-devtools": {
                "type": "local",
                "command": ["npx", "-y", "next-devtools-mcp@latest"],
                "timeout": { "startup": 60000 },
            },
            "playwright": {
                "type": "local",
                "command": ["npx", "-y", "@playwright/mcp@latest"],
            },
            "figma": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "figma-developer-mcp",
                    "--stdio",
                    "--env",
                    ".env.local",
                ],
                "timeout": {
                    "startup": 120000,
                },
            },
        },
    },
}
